APP_NAME=purchase-forecast-service
APP_ENV=local
APP_PORT=8000
LOG_LEVEL=info
TZ=Europe/Moscow
APP_USERNAME=manager
APP_PASSWORD=replace-with-a-long-random-password
REPORT_UPLOAD_DIR=data/uploads
WEATHER_PROVIDER=met-no
WEATHER_LATITUDE=59.9343
WEATHER_LONGITUDE=30.3351
WEATHER_TIMEZONE=Europe/Moscow
WEATHER_CACHE_PATH=data/uploads/met_norway_forecast.json
WEATHER_CACHE_TTL_MINUTES=180
WEATHER_USER_AGENT=purchase-forecast-service/1.0 github.com/example/purchase-forecast-service
STORAGE_BACKEND=local
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-secret-key
SUPABASE_STORAGE_BUCKET=uploads
DATABASE_URL=postgresql://postgres.your-project-id:replace-with-password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

